<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>2035: Crisis Directive</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg: #0b0d10;
            --panel: #14171f;
            --border: #2a303c;
            --text-main: #e2e8f0;
            --text-muted: #94a3b8;
            --accent: #3b82f6;
            --accent-hover: #2563eb;
            --west-col: #1d4ed8;
            --east-col: #b91c1c;
        }

        * { box-sizing: border-box; }

        body {
            background-color: var(--bg);
            color: var(--text-main);
            font-family: 'Inter', sans-serif;
            margin: 0;
            padding: 12px;
            display: flex;
            justify-content: center;
        }

        #game-container {
            width: 100%;
            max-width: 600px;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        /* Top Stats Dashboard */
        #top-bar {
            background: var(--panel);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 12px 16px;
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 8px;
            text-align: center;
        }

        .stat-box {
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .stat-label {
            font-size: 10px;
            text-transform: uppercase;
            color: var(--text-muted);
            font-weight: 600;
        }

        .stat-value {
            font-size: 14px;
            font-weight: 700;
            color: var(--text-main);
            margin-top: 2px;
        }

        /* Navigation Bar */
        #nav-bar {
            display: flex;
            background: var(--panel);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 4px;
            gap: 4px;
        }

        #nav-bar button {
            flex: 1;
            background: transparent;
            color: var(--text-muted);
            border: none;
            padding: 10px;
            font-family: inherit;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            border-radius: 8px;
            transition: all 0.2s ease;
        }

        #nav-bar button.active {
            background: var(--accent);
            color: #fff;
        }

        /* Tab Content Cards */
        .tab-content {
            display: none;
            background: var(--panel);
            border: 1px solid var(--border);
            border-radius: 16px;
            padding: 20px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.4);
        }

        .active-tab { display: block; }

        /* Visual Novel Decision Room Layout */
        #vn-screen {
            position: relative;
            width: 100%;
            height: 380px;
            background: #111;
            border-radius: 12px;
            overflow: hidden;
            border: 1px solid var(--border);
            display: flex;
            flex-direction: column;
            justify-content: flex-end;
            padding: 16px;
            background-image: linear-gradient(to bottom, rgba(15,20,25,0.4), rgba(10,12,16,0.9)), 
                              url('https://placehold.co/600x380/1a212d/475569?text=Visual+Novel+Atmosphere');
            background-size: cover;
            background-position: center;
        }

        .vn-dialog-box {
            background: rgba(14, 17, 23, 0.88);
            backdrop-filter: blur(6px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 10px;
            padding: 16px;
            margin-bottom: 12px;
        }

        #event-title {
            font-size: 15px;
            font-weight: 700;
            margin: 0 0 6px 0;
            color: #60a5fa;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        #event-text {
            font-size: 14px;
            color: var(--text-main);
            line-height: 1.45;
            margin: 0;
        }

        #event-choices {
            display: flex;
            flex-direction: column;
            gap: 8px;
            margin-top: 12px;
        }

        .choice-btn {
            display: block;
            width: 100%;
            background: var(--panel);
            color: var(--text-main);
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: 12px 16px;
            font-family: inherit;
            font-size: 13px;
            font-weight: 500;
            text-align: left;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .choice-btn:active { transform: scale(0.98); }
        .choice-btn:hover {
            background: #1e2532;
            border-color: var(--accent);
            color: #fff;
        }

        /* Map Room Interactive Layout */
        .map-container {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .map-grid-visual {
            display: flex;
            width: 100%;
            height: 220px;
            background: #050608;
            border-radius: 10px;
            border: 1px solid var(--border);
            overflow: hidden;
            position: relative;
        }

        .map-half {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 10px;
            cursor: pointer;
            transition: filter 0.2s;
            position: relative;
        }
        .map-half:hover { filter: brightness(1.2); }

        .map-west { background: rgba(29, 78, 216, 0.25); border-right: 2px dashed #3b82f6; }
        .map-east { background: rgba(185, 28, 28, 0.25); }

        .region-card-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 8px;
        }

        .region-btn {
            background: #11141b;
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 10px;
            text-align: left;
            cursor: pointer;
            font-family: inherit;
            color: var(--text-main);
            transition: border-color 0.2s;
        }
        .region-btn:hover { border-color: var(--accent); }
        .region-btn.selected { border-color: var(--accent); background: #1a2234; }

        #province-info-box {
            background: #0f1218;
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: 14px;
            font-size: 13px;
        }

        #province-info-box h3 { margin: 0 0 6px 0; color: #fff; font-size: 15px; }
        #province-info-box p { margin: 4px 0; color: var(--text-muted); }

        /* Tech Tree */
        .tech-item {
            background: #111;
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: 14px;
            margin-bottom: 12px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .tech-info h4 { margin: 0 0 4px 0; font-size: 15px; color: #fff; }
        .tech-info p { margin: 0; font-size: 12px; color: var(--text-muted); }
        
        .tech-buy {
            background: var(--accent);
            color: #fff;
            border: none;
            border-radius: 8px;
            padding: 8px 14px;
            font-weight: 600;
            font-size: 13px;
            cursor: pointer;
        }
        .tech-buy:hover:not(:disabled) { background: var(--accent-hover); }
        .tech-buy:disabled { background: var(--border); color: var(--text-muted); cursor: not-allowed; }

        h2 { font-size: 18px; margin-top: 0; margin-bottom: 16px; }
    </style>
</head>
<body>

<div id="game-container">
    <!-- Top Bar Stats -->
    <div id="top-bar">
        <div class="stat-box">
            <span class="stat-label">Support</span>
            <span id="stat-support" class="stat-value">40%</span>
        </div>
        <div class="stat-box">
            <span class="stat-label">Funds</span>
            <span id="stat-treasury" class="stat-value">$100M</span>
        </div>
        <div class="stat-box">
            <span class="stat-label">Military</span>
            <span id="stat-military" class="stat-value">40</span>
        </div>
        <div class="stat-box">
            <span class="stat-label">Resources</span>
            <span id="stat-resources" class="stat-value">80</span>
        </div>
        <div class="stat-box">
            <span class="stat-label">Foreign</span>
            <span id="stat-foreign" class="stat-value">50</span>
        </div>
    </div>

    <!-- Navigation -->
    <div id="nav-bar">
        <button id="nav-decision" class="active" onclick="switchTab('view-decision', event)">Bureau</button>
        <button id="nav-map" onclick="switchTab('view-map', event)">War Room</button>
        <button id="nav-tech" onclick="switchTab('view-tech', event)">R&D Tech</button>
    </div>

    <!-- Decision Desk -->
    <div id="view-decision" class="tab-content active-tab">
        <div id="vn-screen">
            <div class="vn-dialog-box">
                <div id="event-title">Loading...</div>
                <div id="event-text">Please wait.</div>
            </div>
        </div>
        <div id="event-choices"></div>
    </div>

    <!-- Map Room (Split Russia Interactive Regions) -->
    <div id="view-map" class="tab-content">
        <h2>Strategic Map: 2035 Federation Split</h2>
        <div class="map-container">
            <div class="map-grid-visual">
                <div class="map-half map-west" onclick="inspectRegion('petrograd')">
                    <span style="color:#60a5fa; font-weight:700; font-size:14px;">WESTERN ZONE</span>
                    <span style="color:#93c5fd; font-size:11px;">Loyalist Control</span>
                </div>
                <div class="map-half map-east" onclick="inspectRegion('siberia')">
                    <span style="color:#f87171; font-weight:700; font-size:14px;">EASTERN SECTOR</span>
                    <span style="color:#fca5a5; font-size:11px;">Separatist Control</span>
                </div>
            </div>

            <p style="margin:0; font-size:12px; color:var(--text-muted);">Select a federal district to inspect logistics and capital status:</p>
            
            <div class="region-card-grid">
                <button class="region-btn" onclick="inspectRegion('petrograd')">
                    <strong>Petrograd Military District</strong><br><span style="font-size:11px; color:var(--text-muted);">Capital: St. Petersburg</span>
                </button>
                <button class="region-btn" onclick="inspectRegion('moscow')">
                    <strong>Central Federal District</strong><br><span style="font-size:11px; color:var(--text-muted);">Capital: Moscow (Core)</span>
                </button>
                <button class="region-btn" onclick="inspectRegion('siberia')">
                    <strong>Siberian Separatists</strong><br><span style="font-size:11px; color:var(--text-muted);">Capital: Novosibirsk</span>
                </button>
                <button class="region-btn" onclick="inspectRegion('volga')">
                    <strong>Volga Industrial Zone</strong><br><span style="font-size:11px; color:var(--text-muted);">Capital: Nizhny Novgorod</span>
                </button>
            </div>

            <div id="province-info-box">
                <h3>Select a Region Above</h3>
                <p>Click any district to view its political alignment, garrison status, and resource output.</p>
            </div>
        </div>
    </div>

    <!-- Tech Tree -->
    <div id="view-tech" class="tab-content">
        <h2>National Upgrades</h2>
        <div class="tech-item">
            <div class="tech-info">
                <h4>Modernized Drilling</h4>
                <p>Boosts Natural Resources output.</p>
            </div>
            <button id="tech-btn-drilling" class="tech-buy" onclick="buyTech('drilling', 50)">$50M</button>
        </div>
        <div class="tech-item">
            <div class="tech-info">
                <h4>State Media Network</h4>
                <p>Passively boosts Public Support.</p>
            </div>
            <button id="tech-btn-propaganda" class="tech-buy" onclick="buyTech('propaganda', 40)">$40M</button>
        </div>
        <div class="tech-item">
            <div class="tech-info">
                <h4>Advanced Logistics</h4>
                <p>Enhances Military readiness.</p>
            </div>
            <button id="tech-btn-logistics" class="tech-buy" onclick="buyTech('logistics', 60)">$60M</button>
        </div>
    </div>
</div>

<script>
    let state = {
        support: 40,
        treasury: 100,
        military: 40,
        resources: 80,
        foreign: 50,
        techs: { drilling: false, propaganda: false, logistics: false }
    };

    const regionData = {
        petrograd: {
            name: "Petrograd Military District",
            capital: "St. Petersburg",
            faction: "Western Government (Loyalist)",
            garrison: "High (24,000 Troops)",
            resources: "Moderate Port Output"
        },
        moscow: {
            name: "Central Federal District",
            capital: "Moscow",
            faction: "Western Government (Capital Zone)",
            garrison: "Critical (Command HQ)",
            resources: "High Financial Hub"
        },
        siberia: {
            name: "Siberian Separatist Front",
            capital: "Novosibirsk",
            faction: "Eastern Faction (Hostile)",
            garrison: "Heavy Armored Division",
            resources: "Massive Oil & Gas Reserves"
        },
        volga: {
            name: "Volga Industrial Zone",
            capital: "Nizhny Novgorod",
            faction: "Contested Buffer Region",
            garrison: "Low Security",
            resources: "Heavy Manufacturing & Steel"
        }
    };

    function inspectRegion(id) {
        let r = regionData[id];
        if(!r) return;
        document.getElementById('province-info-box').innerHTML = `
            <h3 style="color:#60a5fa;">${r.name}</h3>
            <p><strong>Capital:</strong> ${r.capital}</p>
            <p><strong>Political Status:</strong> ${r.faction}</p>
            <p><strong>Garrison:</strong> ${r.garrison}</p>
            <p><strong>Economic Focus:</strong> ${r.resources}</p>
        `;
    }

    function updateUI() {
        document.getElementById('stat-support').innerText = state.support + '%';
        document.getElementById('stat-treasury').innerText = '$' + state.treasury + 'M';
        document.getElementById('stat-military').innerText = state.military;
        document.getElementById('stat-resources').innerText = state.resources;
        document.getElementById('stat-foreign').innerText = state.foreign;
    }

    function applyEffects(effects) {
        if(effects.support) state.support += effects.support;
        if(effects.treasury) state.treasury += effects.treasury;
        if(effects.military) state.military += effects.military;
        if(effects.resources) state.resources += effects.resources;
        if(effects.foreign) state.foreign += effects.foreign;
        
        for (let key in state) {
            if (typeof state[key] === 'number' && key !== 'treasury') {
                if (state[key] > 100) state[key] = 100;
                if (state[key] < 0) state[key] = 0;
            }
        }
        updateUI();
        checkLossCondition();
    }

    function checkLossCondition() {
        if (state.support <= 0) alert("GAME OVER: You were overthrown by a public revolution.");
        if (state.treasury < 0) alert("GAME OVER: State bankruptcy. The military has mutinied.");
    }

    function switchTab(tabId, event) {
        document.querySelectorAll('.tab-content').forEach(el => el.classList.remove('active-tab'));
        document.querySelectorAll('#nav-bar button').forEach(el => el.classList.remove('active'));
        
        document.getElementById(tabId).classList.add('active-tab');
        event.currentTarget.classList.add('active');
    }

    function buyTech(techId, cost) {
        if (state.treasury >= cost && !state.techs[techId]) {
            state.treasury -= cost;
            state.techs[techId] = true;
            
            if (techId === 'drilling') state.resources += 30;
            if (techId === 'propaganda') state.support += 20;
            if (techId === 'logistics') state.military += 25;
            
            updateUI();
            let btn = document.getElementById(`tech-btn-${techId}`);
            btn.disabled = true;
            btn.innerText = "OWNED";
        }
    }

    const storyEvents = {
        "start": {
            title: "The 2035 Schism",
            text: "The President has just been assassinated during a televised national address. The nation has instantly fractured. The military command is split, and you have assumed emergency executive control of the Western Republic. Eastern separatists are mobilizing on the borders. What is your first order?",
            choices: [
                { text: "Secure the capital with martial law (Support -10, Mil +20, Treas -10)", effects: { support: -10, military: 20, treasury: -10 }, next: "sandbox" },
                { text: "Pledge democratic reforms to rally citizens (Support +20, Mil -10)", effects: { support: 20, military: -10 }, next: "sandbox" },
                { text: "Seize the state resource pipelines (Res +30, For -20)", effects: { resources: 30, foreign: -20 }, next: "sandbox" }
            ]
        }
    };

    const sandboxPool = [
        {
            title: "Border Skirmish",
            text: "Eastern separatist forces have probed our defensive lines near the Ural mountains. We must issue a directive.",
            choices: [
                { text: "Repel them with an offensive strike (Mil -10, Support +5)", effects: { military: -10, support: 5 } },
                { text: "De-escalate and offer a ceasefire buffer (For +10, Support -5)", effects: { foreign: 10, support: -5 } }
            ]
        },
        {
            title: "Economic Pressure",
            text: "Foreign powers are threatening severe trade embargos unless we export our national resource reserves at a heavy discount.",
            choices: [
                { text: "Comply to keep trade open (Res -20, For +15, Treas +10)", effects: { resources: -20, foreign: 15, treasury: 10 } },
                { text: "Reject foreign meddling (For -15, Support +10)", effects: { foreign: -15, support: 10 } }
            ]
        },
        {
            title: "Oligarch Proposal",
            text: "A prominent cartel leader offers financial backing for your administration in exchange for state mining concessions.",
            choices: [
                { text: "Accept the dark funds (Treas +30, Res -15, Support -10)", effects: { treasury: 30, resources: -15, support: -10 } },
                { text: "Denounce and arrest them publicly (Treas -10, Support +15, Mil +5)", effects: { treasury: -10, support: 15, military: 5 } }
            ]
        }
    ];

    function loadEvent(eventId) {
        let ev;
        if (eventId === "sandbox") {
            const randomEv = sandboxPool[Math.floor(Math.random() * sandboxPool.length)];
            ev = JSON.parse(JSON.stringify(randomEv)); 
            ev.choices.forEach(c => c.next = "sandbox"); 
        } else {
            ev = storyEvents[eventId];
        }

        if (!ev) return;
        
        document.getElementById('event-title').innerText = ev.title;
        document.getElementById('event-text').innerText = ev.text;
        
        const choicesDiv = document.getElementById('event-choices');
        choicesDiv.innerHTML = ''; 
        
        ev.choices.forEach(choice => {
            const btn = document.createElement('button');
            btn.className = 'choice-btn';
            btn.innerText = choice.text;
            btn.onclick = () => {
                applyEffects(choice.effects);
                loadEvent(choice.next);
            };
            choicesDiv.appendChild(btn);
        });
    }

    updateUI();
    loadEvent("start");
</script>
</body>
</html>
